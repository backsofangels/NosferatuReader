<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/readerBackgroundColor"
    android:keepScreenOn="true">


    <!-- Custom status bar (clock + battery), always visible, mirrors MainActivity/ReaderActivity -->
    <FrameLayout
        android:id="@+id/reader_status_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top chrome (reader controls) sits below the status bar, overlays above content -->
    <LinearLayout
        android:id="@+id/menu_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/readerChromeBackgroundColor"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/reader_status_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/reader_bar_height"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                android:tint="?attr/readerTextColor" />

            <!-- Spacer to push settings/bookmark buttons to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/title_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/reader_title_margin_horizontal"
                android:layout_marginRight="@dimen/reader_title_margin_horizontal"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/readerTextColor"
                android:textSize="@dimen/reader_text_size_md"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/search_button"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_search"
                android:src="@drawable/ic_search"
                android:tint="?attr/readerTextColor"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/zoom_button"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_zoom"
                android:src="@drawable/ic_zoom_out_map"
                android:tint="?attr/readerTextColor"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_reader_settings"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_reader_settings"
                android:src="@drawable/ic_settings_icon"
                android:tint="?attr/readerTextColor" />

            <ImageButton
                android:id="@+id/btn_bookmark_toggle"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_bookmark_toggle"
                android:src="@drawable/ic_bookmark_outline"
                android:tint="?attr/readerTextColor" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/reader_bar_height"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/search_close_button"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@drawable/button"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close"
                android:tint="?attr/readerTextColor" />

            <EditText
                android:id="@+id/search_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/text_search_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="?attr/readerTextColor"
                android:textColorHint="@color/reader_text_muted"
                android:textSize="@dimen/reader_text_size_md" />

            <ImageButton
                android:id="@+id/search_backward_button"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@drawable/button"
                android:contentDescription="@string/cd_search_previous"
                android:src="@drawable/ic_chevron_left"
                android:tint="?attr/readerTextColor" />

            <ImageButton
                android:id="@+id/search_forward_button"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_gravity="center"
                android:background="@drawable/button"
                android:contentDescription="@string/cd_search_next"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/readerTextColor" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="?attr/readerTextColor" />
    </LinearLayout>

    <!-- Main reader content (full screen, unaffected by chrome visibility toggling) -->
    <FrameLayout
        android:id="@+id/reader_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/reader_status_bar_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.artifex.mupdf.mini.PageView
            android:id="@+id/page_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/readerBackgroundColor"
            android:keepScreenOn="true" />
    </FrameLayout>

    <!-- In-reader text/background settings overlay (Compose bridge). Mirrors the app's
         `font_controls_container` from activity_reader.xml; content is supplied at runtime
         by the host app subclass (see NosferatuDocumentActivity). Overlays above reader content. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/font_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/readerChromeBackgroundColor"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/menu_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom chrome, overlays above content -->
    <LinearLayout
        android:id="@+id/menu_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/readerChromeBackgroundColor"
        android:elevation="8dp"
        android:paddingTop="@dimen/reader_bottom_padding"
        android:paddingBottom="@dimen/reader_bottom_padding"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/menu_page_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:alpha="0.8"
            android:ellipsize="end"
            android:singleLine="true"
                android:text="@string/reader_page_unknown"
            android:textColor="?attr/readerTextColor"
            android:textSize="@dimen/reader_text_size_md" />

        <SeekBar
            android:id="@+id/menu_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/reader_menu_seek_margin_horizontal"
            android:layout_marginTop="@dimen/reader_menu_seek_margin_top"
                android:layout_marginEnd="@dimen/reader_menu_seek_margin_horizontal"
            android:max="0"
            android:progressTint="?attr/readerTextColor"
            android:thumbTint="?attr/readerTextColor" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_16"
            android:alpha="0.2"
            android:background="?attr/readerTextColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_toc"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_open_toc"
                android:src="@drawable/ic_toc"
                android:tint="?attr/readerTextColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/reader_menu_title_margin_horizontal"
                android:layout_marginEnd="@dimen/reader_menu_title_margin_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menu_book_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/readerTextColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/menu_book_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/readerTextColor"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_bookmarks"
                android:layout_width="@dimen/reader_icon_size"
                android:layout_height="@dimen/reader_icon_size"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@android:color/transparent"
                android:padding="@dimen/reader_icon_padding"
                android:contentDescription="@string/cd_open_bookmarks"
                android:src="@drawable/ic_books"
                android:tint="?attr/readerTextColor" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/immersive_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/readerBackgroundColor"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/immersive_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/reader_progress_height"
            android:max="1"
            android:progress="0"
            android:progressBackgroundTint="?attr/readerProgressBackgroundColor"
            android:progressTint="?attr/readerTextColor" />

        <TextView
            android:id="@+id/immersive_footer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.75"
            android:gravity="center"
            android:paddingStart="@dimen/reader_label_padding"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/reader_label_padding"
            android:paddingBottom="@dimen/spacing_md"
            android:text="@string/reader_page_unknown"
            android:textColor="?attr/readerTextColor"
            android:textSize="@dimen/reader_text_size_sm" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
