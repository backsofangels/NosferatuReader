<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_pressed="true">
		<shape android:shape="oval">
			<solid android:color="@color/reader_button_pressed" />
			<padding android:left="@dimen/reader_icon_padding" android:top="@dimen/reader_icon_padding" android:right="@dimen/reader_icon_padding" android:bottom="@dimen/reader_icon_padding" />
		</shape>
	</item>
	<item>
		<shape android:shape="oval">
			<solid android:color="@android:color/transparent" />
			<padding android:left="@dimen/reader_icon_padding" android:top="@dimen/reader_icon_padding" android:right="@dimen/reader_icon_padding" android:bottom="@dimen/reader_icon_padding" />
		</shape>
	</item>
</selector>
